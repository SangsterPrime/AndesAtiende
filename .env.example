# Los defaults del compose son DE DEMO; NO usar credenciales de ejemplo en produccion.
# El compose no requiere .env en el PC del profesor.
# Cambiar REEMPLAZAR_USUARIO en compose.yaml antes de etiquetar ep2.

NVIDIA_API_KEY=
NVIDIA_MODEL=

# EP3: local conserva EP2; sagemaker no carga archivos .joblib.
IA_BACKEND=local
SAGEMAKER_ENDPOINT_NAME=
# Región fijada por servicio-ia: us-east-1. En EC2 usar el instance profile IAM.
# No agregar claves AWS aquí; las variables NVIDIA no son necesarias para clasificar.

# API EP3: configurar solo en el entorno del servidor (dominio y gateway).
# Secreto aleatorio de 32-128 caracteres A-Z, a-z, 0-9, _ o -; sin valor por defecto.
# No copiar a variables VITE_*, JavaScript, logs, capturas ni al repositorio.
EP3_API_KEY=

# Usado por compose.llm.yaml. Generar un valor local, p. ej. openssl rand -hex 32.
RABBITMQ_PASSWORD=
