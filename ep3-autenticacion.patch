+def matches_secret(value: str | None, variable: str) -> bool:
+    expected = os.getenv(variable)
+    return bool(expected and value and secrets.compare_digest(value.encode(), expected.encode()))
+
+
+class KeyProtectedRoute(APIRoute):
+    """Authenticate before FastAPI reads or validates the JSON body."""
+    def get_route_handler(self):
+        handler = super().get_route_handler()
+
+        async def authenticated(request: Request):
+            if not matches_secret(await api_key(request), 'EP3_API_KEY'):
+                raise HTTPException(status_code=401, detail='Clave API ausente o incorrecta')
+            return await handler(request)
+
+        return authenticated
+
+
+# The dependency also declares the security scheme in OpenAPI.
+protected = APIRouter(route_class=KeyProtectedRoute, dependencies=[Depends(api_key)])
+
